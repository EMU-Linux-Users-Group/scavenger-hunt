#!/bin/sh
# Runs Ready Player Root with the Python that ships next to this script, so the
# computer doesn't need Python installed and nobody needs an admin password.
# Usage: ready-player-root start | stop

DIR=$(cd "$(dirname "$0")" && pwd -P)
PYTHON="$DIR/python/$(uname -m)/bin/python3"
if [ ! -x "$PYTHON" ]; then
    PYTHON=python3
fi

# A browser download marks every file as quarantined, and macOS then refuses to
# run the bundled Python. Whoever owns the files can clear the mark.
if command -v xattr >/dev/null 2>&1 && xattr -p com.apple.quarantine "$PYTHON" >/dev/null 2>&1; then
    xattr -dr com.apple.quarantine "$DIR" 2>/dev/null
fi

exec "$PYTHON" "$DIR/scavenger_hunt.py" "$@"
